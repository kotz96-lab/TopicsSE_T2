# Copy this file to `.env` and fill in real values.
# `.env` is gitignored.

OPENROUTER_API_KEY=sk-or-your-key-here

# Optional: override default models (comma-separated OpenRouter model IDs)
# LLM_MODELS=openai/gpt-4o-mini,anthropic/claude-3.5-haiku

# Optional: OpenRouter recommends setting these headers
OPENROUTER_APP_NAME=TopicsSE_T2-FaultLocalization
OPENROUTER_HTTP_REFERER=https://github.com/kotz96-lab/TopicsSE_T2
